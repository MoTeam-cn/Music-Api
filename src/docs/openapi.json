{
  "openapi": "3.0.3",
  "info": {
    "title": "music-api",
    "version": "0.1.0",
    "description": "公开音乐元数据聚合接口（网易云 / QQ 音乐 / 酷狗 / 百度音乐）。只读、零运行时依赖、支持 JSONP，不设 CORS。所有 /v1 接口必须携带 origin；常见 HTTP 库默认 UA 会被拦截。仅供技术研究与学习，不提供 VIP/付费内容。",
    "license": {
      "name": "MIT (code only)"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8802",
      "description": "本地默认"
    }
  ],
  "tags": [
    {
      "name": "music"
    },
    {
      "name": "meta"
    }
  ],
  "paths": {
    "/v1/search": {
      "get": {
        "tags": [
          "music"
        ],
        "summary": "搜索歌曲（支持四源聚合）",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "description": "关键词"
          },
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "netease",
                "tencent",
                "kugou",
                "baidu"
              ]
            },
            "description": "音源；all 表示四源并发聚合（仅搜索支持）"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "song"
              ],
              "default": "song"
            },
            "description": "目前仅实现 song"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "callback",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*){0,3}$"
            },
            "description": "JSONP 回调名；别名 cb"
          },
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9._:/-]{1,64}$"
            },
            "description": "调用来源标识（必填），如 web / app-ios / example.com；用于日志与统计"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。JSON 模式按 code 映射 HTTP；带 callback 时返回 application/javascript 且 HTTP 恒 200。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              },
              "application/javascript": {
                "schema": {
                  "type": "string",
                  "example": "/**/typeof cb === 'function' && cb({...});"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "UA 被拦截（4002）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "429": {
            "description": "限流",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
