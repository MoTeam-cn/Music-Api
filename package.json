{
  "name": "music-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "公开音乐元数据聚合接口（网易云 / QQ 音乐 / 酷狗 / 百度音乐）。只读、零运行时依赖、支持 JSONP。仅供学习研究，请勿用于商业用途。",
  "keywords": [
    "music-api",
    "netease",
    "qqmusic",
    "kugou",
    "baidu-music",
    "typescript",
    "nodejs",
    "jsonp"
  ],
  "homepage": "https://github.com/MoTeam-cn/Music-Api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoTeam-cn/Music-Api.git"
  },
  "bugs": {
    "url": "https://github.com/MoTeam-cn/Music-Api/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test --test-isolation=none \"test/*.test.ts\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "probe": "node tools/probe.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
